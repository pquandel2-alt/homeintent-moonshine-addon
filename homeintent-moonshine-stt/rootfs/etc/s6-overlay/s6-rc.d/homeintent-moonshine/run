#!/command/with-contenv bashio

# vim: ft=bash

set -e

export PYTHONUNBUFFERED=1
export MOONSHINE_VOICE_CACHE=/data/models
export HF_HOME=/data/models/pocket-tts

# Read a config option, falling back to a hard-coded default (matching
# config.yaml's own default) whenever the Supervisor value is absent,
# empty, or the literal string "null".
#
# This exists so an upgrade from an older add-on version -- where the
# user's persisted options.json predates a newer config.yaml key -- or any
# other situation where bashio::config resolves to an empty/null value
# never turns into "--some-flag null" being handed to argparse (which
# expects e.g. a float and would then crash the whole add-on on every
# start). bashio::config itself supports a default-value second argument
# on current versions; the explicit empty/"null" check below is a second,
# independent safety net that does not depend on that behavior.
config_or_default() {
    local key="$1" default="$2" value
    value=$(bashio::config "${key}" "${default}" 2>/dev/null || true)
    if [ -z "${value}" ] || [ "${value}" = "null" ]; then
        value="${default}"
    fi
    printf '%s' "${value}"
}

# Read a boolean config option the same way, additionally tolerating a
# missing/null/empty value by falling back to the given default ("true" or
# "false") before handing the result to bashio::var.true.
config_bool_or_default() {
    local key="$1" default="$2"
    config_or_default "${key}" "${default}"
}

# Defaults below must match homeintent-moonshine-stt/config.yaml's `options:`
# block exactly -- see app/tests/test_fake_supervisor_config_sync.py, which
# fails CI if they drift apart.
STT_ENABLED=$(config_bool_or_default 'stt_enabled' 'true')
MODEL=$(config_or_default 'model' 'small')
LANGUAGE=$(config_or_default 'language' 'de')
LOG_LEVEL=$(config_or_default 'log_level' 'INFO')
LOG_TRANSCRIPTS=$(config_bool_or_default 'log_transcripts' 'false')
LOG_PERFORMANCE=$(config_bool_or_default 'log_performance' 'true')
EXTRA_KEYTERMS=$(bashio::config 'extra_keyterms' '' 2>/dev/null || true)
KEYTERM_BOOST=$(config_or_default 'keyterm_boost' '2.0')
USE_HA_VOCABULARY=$(config_bool_or_default 'use_ha_vocabulary' 'true')
HA_VOCABULARY_REFRESH_MINUTES=$(config_or_default 'ha_vocabulary_refresh_minutes' '30')
TRANSCRIPTION_INTERVAL=$(config_or_default 'transcription_interval' '0.5')
VAD_THRESHOLD=$(config_or_default 'vad_threshold' '0.5')
DECODE_INCOMPLETE_LINES=$(config_bool_or_default 'decode_incomplete_lines' 'true')
SAVE_DEBUG_AUDIO=$(config_bool_or_default 'save_debug_audio' 'false')
DEBUG_AUDIO_MAX_FILES=$(config_or_default 'debug_audio_max_files' '100')
TTS_ENABLED=$(config_bool_or_default 'tts_enabled' 'false')
TTS_MODEL=$(config_or_default 'tts_model' 'german')
TTS_VOICE=$(config_or_default 'tts_voice' 'juergen')
TTS_LOG_PERFORMANCE=$(config_bool_or_default 'tts_log_performance' 'true')
TTS_WARMUP=$(config_bool_or_default 'tts_warmup' 'true')

# EXTRA_KEYTERMS is a free-text field; "null" is a legitimate (if unlikely)
# keyterm-list entry only if a user literally typed it, but an *absent*
# option must not become the four-character string "null" and get passed
# to the transcriber. bashio::config's own default already covers "absent";
# this only strips a literal empty-after-default case.
if [ "${EXTRA_KEYTERMS}" = "null" ]; then
    EXTRA_KEYTERMS=""
fi

bashio::log.info "Starting HomeIntent Moonshine Voice"
bashio::log.info "STT enabled: ${STT_ENABLED}"
if bashio::var.true "${STT_ENABLED}"; then
    bashio::log.info "STT model: ${MODEL}"
    bashio::log.info "STT language: ${LANGUAGE}"
fi
bashio::log.info "TTS enabled: ${TTS_ENABLED}"
if bashio::var.true "${TTS_ENABLED}"; then
    bashio::log.info "TTS model: ${TTS_MODEL}"
    bashio::log.info "TTS voice: ${TTS_VOICE}"
fi
bashio::log.info "Log Level: ${LOG_LEVEL}"

# Build flags
FLAGS=()

FLAGS+=("--model" "${MODEL}")
FLAGS+=("--language" "${LANGUAGE}")
FLAGS+=("--port" "10300")
FLAGS+=("--extra-keyterms" "${EXTRA_KEYTERMS}")
FLAGS+=("--keyterm-boost" "${KEYTERM_BOOST}")
FLAGS+=("--ha-vocabulary-refresh-minutes" "${HA_VOCABULARY_REFRESH_MINUTES}")
FLAGS+=("--transcription-interval" "${TRANSCRIPTION_INTERVAL}")
FLAGS+=("--vad-threshold" "${VAD_THRESHOLD}")
FLAGS+=("--debug-audio-max-files" "${DEBUG_AUDIO_MAX_FILES}")
FLAGS+=("--tts-model" "${TTS_MODEL}")
FLAGS+=("--tts-voice" "${TTS_VOICE}")

if bashio::var.true "${STT_ENABLED}"; then
    FLAGS+=("--stt-enabled")
else
    FLAGS+=("--no-stt-enabled")
fi

if bashio::var.true "${TTS_ENABLED}"; then
    FLAGS+=("--tts-enabled")
else
    FLAGS+=("--no-tts-enabled")
fi

if bashio::var.true "${TTS_LOG_PERFORMANCE}"; then
    FLAGS+=("--tts-log-performance")
else
    FLAGS+=("--no-tts-log-performance")
fi

if bashio::var.true "${TTS_WARMUP}"; then
    FLAGS+=("--tts-warmup")
else
    FLAGS+=("--no-tts-warmup")
fi

if [ "${LOG_LEVEL}" = "DEBUG" ]; then
    FLAGS+=("--debug")
fi

if bashio::var.true "${LOG_TRANSCRIPTS}"; then
    FLAGS+=("--log-transcripts")
fi

if bashio::var.true "${LOG_PERFORMANCE}"; then
    FLAGS+=("--log-performance")
else
    FLAGS+=("--no-log-performance")
fi

if bashio::var.true "${USE_HA_VOCABULARY}"; then
    FLAGS+=("--use-ha-vocabulary")
else
    FLAGS+=("--no-use-ha-vocabulary")
fi

if bashio::var.true "${DECODE_INCOMPLETE_LINES}"; then
    FLAGS+=("--decode-incomplete-lines")
else
    FLAGS+=("--no-decode-incomplete-lines")
fi

if bashio::var.true "${SAVE_DEBUG_AUDIO}"; then
    FLAGS+=("--save-debug-audio")
fi

# Run the application. cwd must be "/", not "/app": COPY app/ /app/ places the
# "app" package directly at /app, so "-m app" needs /app's *parent* on sys.path.
cd /
exec python3 -m app "${FLAGS[@]}"
